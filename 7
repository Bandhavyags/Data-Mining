import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import cross_val_score

data = pd.read_csv("/content/drive/MyDrive/Colab Notebooks/german_credit.csv")
le = LabelEncoder()

for col in data.columns:
 if data[col].dtype == object:
   data[col] = le.fit_transform(data[col])

y = data.iloc[:,-1]

# All attributes
X_all = data.iloc[:,:-1]
s_all = cross_val_score(DecisionTreeClassifier(criterion='entropy', random_state=42),X_all, y, cv=10)

# Selected attributes
# selected = ['credit_history', 'purpose', 'employment_duration',
#  'other_debtors', 'housing', 'present_residence']

selected = ['status','amount','duration','credit_history','savings']

X_sel = data[selected]
s_sel = cross_val_score(DecisionTreeClassifier(criterion='entropy',random_state=42),X_sel, y, cv=10)

print(f"All Attributes -> Avg Accuracy: {s_all.mean()*100:.2f}%")
print(f"Selected Attributes -> Avg Accuracy: {s_sel.mean()*100:.2f}%")
print(f"Difference -> {abs(s_all.mean()-s_sel.mean())*100:.2f}% ")
